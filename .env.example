# Copy to .env and replace every placeholder before deployment.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=System Administrator

# SQLite is the supported local configuration. Relative paths resolve from the project root.
DATABASE_URL=sqlite:///./data/ordinance.db
DATA_DIR=./data
MAX_UPLOAD_MB=50
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ephemeral Storage Optimization:
# When true, raw PDF files and bulky page OCR images are deleted immediately after
# text, sections, and vector embeddings are stored in SQLite/FTS5 (saves ~90% disk space).
DISPOSE_ORIGINALS=true
DISPOSE_PAGE_IMAGES=true

# OCR (Tesseract must be installed separately).
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_ENABLED=true
OCR_LANG=eng
OCR_DPI=300
OCR_TIMEOUT_SECONDS=180

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

CHUNK_MAX_CHARS=1400
CHUNK_OVERLAP_CHARS=180
CHUNK_MIN_CHARS=120

RETRIEVAL_TOP_K=10
RETRIEVAL_MIN_SCORE=0.22
RETRIEVAL_VECTOR_MIN_SCORE=0.48
VECTOR_WEIGHT=0.62
KEYWORD_WEIGHT=0.38
RERANK_ENABLED=true
RATE_LIMIT_SEARCH_PER_MINUTE=60

WORKER_ENABLED=true
WORKER_POLL_SECONDS=1.5

# Convex Cloud Database URL (Obtained from `npx convex dev` or `npx convex deploy`)
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Google Gemini Multi-Model OCR Spell & Formatting Assistant (Optional but recommended)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Frontend proxy target; set API_PROXY_URL when the backend is not on localhost:8000.
API_PROXY_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=/backend
