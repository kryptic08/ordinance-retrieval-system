# =========================================================================
# OrdiSearch Frontend Environment Variables
# =========================================================================

# 1. Convex Cloud Real-Time Database URL (Generated by `npx convex dev` or `npx convex deploy`)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# 2. Python FastAPI Backend Proxy URL (Defaults to localhost:8000 in dev)
# In production on Vercel, set this to your cloud backend (e.g. https://ordisearch-api.onrender.com)
API_PROXY_URL=http://127.0.0.1:8000

# 3. Next.js Static Export (set to "export" only when building static HTML into /out)
# NEXT_OUTPUT_MODE=export
